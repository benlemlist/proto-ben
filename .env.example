# Copy this file to .env.local (git-ignored), paste ONE key, then restart `pnpm dev`.
# The key stays on the server side: the /api/agent proxy reads it (vite-plugin-agent.ts).
# With no key, AI features use their mock.

# DeepSeek through OpenRouter (a key that starts with sk-or-). Used first.
OPENROUTER_API_KEY=

# DeepSeek's own API (a key from https://platform.deepseek.com/api_keys).
DEEPSEEK_API_KEY=
